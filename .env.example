# Copy this file to .env and adjust.

# MySQL 8 or MariaDB. This value matches docker-compose.yml (host port 8081).
DATABASE_URL=mysql://livingfoods:livingfoods@127.0.0.1:8081/livingfoods

# Signs sign-in sessions. Use a long random string and keep it private.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created by `pnpm db:seed` (password: at least 8 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Optional
# PORT=3000
# UPLOAD_DIR=uploads

# --- Order alerts (optional; each channel switches on when its variables are set) ---

# Email. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
# SMTP_PASS=an App Password (Google Account > Security > App passwords), not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# ALERT_EMAIL_TO=orders@livingfoodspk.com, owner@example.com
# ALERT_EMAIL_FROM=Living Foods <you@gmail.com>

# WhatsApp (Meta WhatsApp Cloud API). See README "Order alerts" for the template to get approved.
# WHATSAPP_TOKEN=permanent-system-user-access-token
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# ALERT_WHATSAPP_TO=0345 9024745, 0300 1234567
# WHATSAPP_TEMPLATE=new_order_alert
# WHATSAPP_TEMPLATE_LANG=en
