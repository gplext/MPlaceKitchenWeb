# Copy this file to .env and adjust.

# MySQL 8 or MariaDB. This value matches docker-compose.yml (host port 8081).
DATABASE_URL=mysql://livingfoods:livingfoods@127.0.0.1:8081/livingfoods

# Signs sign-in sessions. Use a long random string and keep it private.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created by `pnpm db:seed` (password: at least 8 characters).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Optional
# PORT=3000
# UPLOAD_DIR=uploads
